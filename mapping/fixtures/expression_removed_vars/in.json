          "match": {
            "0": {
              "if": "retry_num > 2",
              "then": "'Mailer'"
            }
          },
          "else": "'Daemon'"
        },
        "fromAddress": {
          "match": {},
          "else": "'postmaster@example.com'"
        }
      }
    },
    {
      "key": "x:SieveUserInterpreter",
      "value": {
        "dkimSignDomain": {
          "match": {
            "0": {
              "if": "retry_num > 1",
              "then": "'a'"
            }
          },
          "else": "'b'"
        }
      }
    },
    {
